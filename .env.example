# ==============================================================================
# DevPilot AI - Environment Configuration Template (.env.example)
# ==============================================================================

# --- Database (PostgreSQL) ---
POSTGRES_DB=ai_agent_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=Postgres123!
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- JWT Authentication (MUST be a random, cryptographically secure 256-bit string in production) ---
JWT_SECRET_KEY=change_me_to_a_secure_random_at_least_32_character_string_for_production!
JWT_ISSUER=DevPilotAI
JWT_AUDIENCE=DevPilotAIUsers
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=7

# --- API Key Vault Master Encryption Key (AES-256 GCM/HMAC) ---
ENCRYPTION_API_KEY_SECRET=change_me_to_a_secure_master_aes256_encryption_key_in_production!

# --- Frontend & CORS Origins ---
FRONTEND_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- External AI Providers ---
GROQ_API_KEY=gsk_your_groq_api_key_here
TAVILY_API_KEY=tvly_your_tavily_api_key_here

# --- Security Scanner Configuration (Ollama Qwen2.5-Coder Engine) ---
STRIX_LLM=qwen2.5-coder:latest
OLLAMA_ENDPOINT=http://host.docker.internal:11434
LLM_API_KEY=ollama
LLM_API_BASE=http://host.docker.internal:11434

# Security Scan Limits
STRIX_TIMEOUT_MINUTES=15
STRIX_DEFAULT_SCAN_MODE=quick
STRIX_ENABLE_DIAGNOSTICS_FALLBACK=true

# --- Email Notifications (Optional SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=your_email@gmail.com

# --- Frontend (Vite / React) ---
VITE_API_BASE_URL=/api
VITE_APP_NAME=DevPilot AI
VITE_MAX_UPLOAD_MB=20
VITE_REQUEST_TIMEOUT_MS=30000
VITE_ENABLE_MOCK_FALLBACK=false
