{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=ai_agent_db;Username=postgres;Password=YOUR_POSTGRES_PASSWORD"
  },
  "Jwt": {
    "Issuer": "DevPilotAI",
    "Audience": "DevPilotAIUsers",
    "SecretKey": "YOUR_SUPER_SECRET_JWT_SIGNING_KEY_AT_LEAST_32_CHARS!",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  "Encryption": {
    "ApiKeySecret": "YOUR_MASTER_AES256_ENCRYPTION_KEY_AT_LEAST_32_CHARS!"
  },
  "Groq": {
    "ApiKey": "YOUR_GROQ_API_KEY",
    "Model": "qwen/qwen3.8-27b",
    "WhisperModel": "whisper-large-v3-turbo",
    "BaseUrl": "https://api.groq.com/openai/v1"
  },
  "Tavily": {
    "ApiKey": "YOUR_TAVILY_API_KEY",
    "BaseUrl": "https://api.tavily.com"
  },
  "Frontend": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173",
      "http://localhost:3000"
    ]
  },
  "EmailSettings": {
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "SmtpUser": "your_email@gmail.com",
    "SmtpPassword": "your_smtp_app_password",
    "FromEmail": "your_email@gmail.com",
    "FromName": "DevPilot AI",
    "FrontendBaseUrl": "http://localhost:3000"
  },
  "Strix": {
    "Executable": "embedded",
    "ProjectPath": "embedded",
    "WorkingDirectory": "embedded",
    "TimeoutMinutes": 15,
    "DefaultScanMode": "quick",
    "LlmModel": "qwen2.5-coder:latest",
    "LlmApiKey": "ollama",
    "LlmApiBase": "http://host.docker.internal:11434",
    "OllamaEndpoint": "http://host.docker.internal:11434",
    "EnableDiagnosticsFallback": true
  }
}
