{
  "version": "0.2.0",
  "configurations": [
    {
      "name": ".NET WebApi Launch (DevPilot AI)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/WebChatAI.WebApi/bin/Debug/net9.0/WebChatAI.WebApi.dll",
      "args": [],
      "cwd": "${workspaceFolder}/WebChatAI.WebApi",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openUrl",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/scalar/v1"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "sourceFileMap": {
        "/views": "${workspaceFolder}/Views"
      }
    },
    {
      "name": ".NET Attach",
      "type": "coreclr",
      "request": "attach"
    }
  ]
}
